# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ========================================================
# GITHUB INTEGRATION & OAUTH CONFIGURATION
# ========================================================
# Register at: https://github.com/settings/developers
# Authorization Callback URL:
# Dev: https://ais-dev-6qjsnmbihwmz763wriv4vq-35388113219.us-west1.run.app/auth/github/callback
# Shared: https://ais-pre-6qjsnmbihwmz763wriv4vq-35388113219.us-west1.run.app/auth/github/callback
GITHUB_CLIENT_ID="TU_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="TU_GITHUB_CLIENT_SECRET"

# ========================================================
# AVALANCHE & WEB3 CONFIGURATION (OPCIONAL / PAUSADO)
# ========================================================

# Avalanche Fuji Testnet RPC (Chain ID: 43113)
VITE_AVALANCHE_FUJI_RPC="https://api.avax-test.network/ext/bc/C/rpc"

# Contrato Inteligente ArcadePoapBadge desplegado en Fuji
VITE_POAP_CONTRACT_ADDRESS="0x5B38Da6a701c568545dCfcB03FcB875f56beddC4"

# Privy App ID para Embedded Wallets por Email/Social (dashboard.privy.io)
VITE_PRIVY_APP_ID="clx_arcade_studio_fuji_dev"

# Paymaster / Bundler ERC-4337 (Pimlico / Biconomy / ZeroDev)
# Usado para patrocinar el 100% de los gas fees a los asistentes del evento
VITE_PAYMASTER_RPC_URL="https://api.pimlico.io/v2/43113/rpc?apikey=TU_API_KEY_AQUI"
VITE_SPONSORSHIP_POLICY_ID="sp_arcade_events_sponsorship"

# Clave privada del Relayer Backend (Gas Sponsor Vault en Avalanche Fuji)
# IMPORTANTE: Solo en backend server-side, NUNCA en el cliente
